# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env) - PROJETO FP&A INDUSTRIAL
# ==============================================================================
# Instruções: Copie este arquivo para .env e preencha conforme seu ambiente.

# Ambiente de Execução (development, staging, production)
ENVIRONMENT=development

# Caminho do Banco de Dados Relacional / Data Warehouse Local
DB_PATH=data/fpa_industrial_dw.db

# Nível de Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Diretório de Gravação dos Logs
LOG_DIR=logs
